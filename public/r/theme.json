{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Pulse",
  "description": "The Pulse design tokens - surfaces, accents, foreground and hairlines - as a Tailwind v4 theme, plus the reset the components are drawn against and the Overpass Mono typeface.",
  "dependencies": [
    "@fontsource/overpass-mono"
  ],
  "cssVars": {
    "theme": {
      "color-background": "var(--background)",
      "color-foreground": "var(--foreground)",
      "color-card": "var(--card)",
      "color-card-foreground": "var(--card-foreground)",
      "color-popover": "var(--popover)",
      "color-popover-foreground": "var(--popover-foreground)",
      "color-primary": "var(--primary)",
      "color-primary-foreground": "var(--primary-foreground)",
      "color-secondary": "var(--secondary)",
      "color-secondary-foreground": "var(--secondary-foreground)",
      "color-muted": "var(--muted)",
      "color-muted-foreground": "var(--muted-foreground)",
      "color-accent": "var(--accent)",
      "color-accent-foreground": "var(--accent-foreground)",
      "color-destructive": "var(--destructive)",
      "color-destructive-foreground": "var(--destructive-foreground)",
      "color-warning": "var(--warning)",
      "color-warning-foreground": "var(--warning-foreground)",
      "color-success": "var(--success)",
      "color-success-foreground": "var(--success-foreground)",
      "color-border": "var(--border)",
      "color-input": "var(--input)",
      "color-ring": "var(--ring)",
      "color-chart-1": "var(--chart-1)",
      "color-chart-2": "var(--chart-2)",
      "color-chart-3": "var(--chart-3)",
      "color-chart-4": "var(--chart-4)",
      "color-chart-5": "var(--chart-5)",
      "color-sidebar": "var(--sidebar)",
      "color-sidebar-foreground": "var(--sidebar-foreground)",
      "color-sidebar-primary": "var(--sidebar-primary)",
      "color-sidebar-primary-foreground": "var(--sidebar-primary-foreground)",
      "color-sidebar-accent": "var(--sidebar-accent)",
      "color-sidebar-accent-foreground": "var(--sidebar-accent-foreground)",
      "color-sidebar-border": "var(--sidebar-border)",
      "color-sidebar-ring": "var(--sidebar-ring)",
      "color-border-strong": "var(--border-strong)",
      "color-border-soft": "var(--border-soft)",
      "color-ink": "var(--ink)",
      "font-mono": "var(--type-mono)",
      "ease-pulse": "cubic-bezier(0.4, 0, 0.2, 1)",
      "radius-sm": "calc(var(--radius) * 0.6)",
      "radius-md": "calc(var(--radius) * 0.8)",
      "radius-lg": "var(--radius)",
      "radius-xl": "calc(var(--radius) * 1.4)",
      "radius-2xl": "calc(var(--radius) * 1.8)",
      "radius-3xl": "calc(var(--radius) * 2.2)",
      "radius-4xl": "calc(var(--radius) * 2.6)"
    }
  },
  "css": {
    "@import \"@fontsource/overpass-mono/400.css\"": {},
    "@import \"@fontsource/overpass-mono/500.css\"": {},
    "@import \"@fontsource/overpass-mono/600.css\"": {},
    "@import \"@fontsource/overpass-mono/700.css\"": {},
    "@layer base": {
      ":root": {
        "--background": "light-dark(oklch(100% 0 none), oklch(0% 0 none))",
        "--foreground": "light-dark(oklch(18% 0 none), oklch(100% 0 none))",
        "--card": "light-dark(oklch(97.5% 0 none), oklch(17.22% 0.0115 260.6))",
        "--card-foreground": "var(--foreground)",
        "--popover": "var(--card)",
        "--popover-foreground": "var(--foreground)",
        "--primary": "light-dark(oklch(55% 0.0931 189.5), oklch(91.98% 0.1236 189.5))",
        "--primary-foreground": "var(--ink)",
        "--secondary": "light-dark(oklch(52% 0 none), oklch(80.47% 0 none))",
        "--secondary-foreground": "var(--ink)",
        "--destructive": "light-dark(oklch(55% 0.1236 29), oklch(78.5% 0.1236 29))",
        "--destructive-foreground": "var(--ink)",
        "--warning": "light-dark(oklch(55% 0.1103 91.2), oklch(87.33% 0.1505 91.2))",
        "--warning-foreground": "var(--ink)",
        "--success": "light-dark(oklch(55% 0.1236 145), oklch(91.98% 0.1236 145))",
        "--success-foreground": "var(--ink)",
        "--muted": "light-dark(oklch(94.5% 0 none), oklch(22.5% 0.009 255.6))",
        "--muted-foreground": "color-mix(in oklch, var(--foreground) 70%, transparent)",
        "--accent": "var(--muted)",
        "--accent-foreground": "var(--foreground)",
        "--ink": "light-dark(oklch(100% 0 none), oklch(0% 0 none))",
        "--border": "color-mix(in oklch, var(--foreground) 62%, transparent)",
        "--border-strong": "color-mix(in oklch, var(--foreground) 40%, transparent)",
        "--border-soft": "color-mix(in oklch, var(--foreground) 30%, transparent)",
        "--input": "color-mix(in oklch, var(--foreground) 45%, transparent)",
        "--ring": "var(--primary)",
        "--chart-1": "light-dark(oklch(45% 0 none), oklch(52% 0 none))",
        "--chart-2": "var(--primary)",
        "--chart-3": "var(--warning)",
        "--chart-4": "var(--success)",
        "--chart-5": "var(--destructive)",
        "--sidebar": "var(--card)",
        "--sidebar-foreground": "var(--foreground)",
        "--sidebar-primary": "var(--primary)",
        "--sidebar-primary-foreground": "var(--ink)",
        "--sidebar-accent": "var(--muted)",
        "--sidebar-accent-foreground": "var(--foreground)",
        "--sidebar-border": "var(--border-soft)",
        "--sidebar-ring": "var(--primary)",
        "--radius": "0",
        "--type-mono": "'Overpass Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace",
        "--text-display": "clamp(2rem, 1.5rem + 2.5vw, 2.5rem)",
        "--duration-fast": "120ms",
        "--duration-base": "160ms",
        "--duration-slow": "200ms",
        "interpolate-size": "allow-keywords",
        "scrollbar-gutter": "stable",
        "text-wrap": "pretty",
        "overflow-wrap": "break-word",
        "font-synthesis": "none",
        "color-scheme": "dark",
        "overscroll-behavior-y": "none"
      },
      "[data-theme='dark'],\n.dark": {
        "color-scheme": "dark"
      },
      "[data-theme='light']": {
        "color-scheme": "light"
      },
      "[data-theme='system']": {
        "color-scheme": "light dark"
      },
      "h1,\nh2,\nh3,\nh4": {
        "text-wrap": "balance"
      },
      "input,\ntextarea,\nselect": {
        "font-size": "max(16px, 1rem)"
      },
      "body": {
        "margin": "0",
        "min-height": "100svh",
        "background": "var(--background)",
        "color": "var(--foreground)",
        "font-family": "var(--font-mono)",
        "font-size": "14px",
        "line-height": "1.5",
        "letter-spacing": "0",
        "-webkit-font-smoothing": "antialiased",
        "-moz-osx-font-smoothing": "grayscale"
      },
      ":where(button, a, [role='button'])": {
        "touch-action": "manipulation"
      },
      "::selection": {
        "background": "var(--primary)",
        "color": "var(--ink)"
      }
    }
  },
  "docs": "The tokens are light-dark() pairs resolved by color-scheme, never a second block of variables\nunder a media query or a .dark class. Pulse is dark-first: :root sets color-scheme: dark, and\ndata-theme=\"light\" opts into the light column. Switch themes by setting color-scheme, never by\nredefining a token - light-dark() resolves per element, so a subtree with its own color-scheme\nflips on its own.\n\nThis item also carries Overpass Mono, the only typeface the system uses, at the four weights the\ncomponents use. A component item leaves the font out on purpose, so that adding a Button does not\nalso add a font package; the family falls back to the monospace stack until this item is installed.",
  "categories": [
    "theme"
  ],
  "type": "registry:theme"
}