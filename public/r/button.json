  "css": {
    "@layer base": {
      ":root": {
        "--background": "light-dark(oklch(100% 0 none), oklch(0% 0 none))",
        "--foreground": "light-dark(oklch(18% 0 none), oklch(100% 0 none))",
        "--card": "light-dark(oklch(97.5% 0 none), oklch(17.22% 0.0115 260.6))",
        "--card-foreground": "var(--foreground)",
        "--popover": "var(--card)",
        "--popover-foreground": "var(--foreground)",
        "--primary": "light-dark(oklch(55% 0.0931 189.5), oklch(91.98% 0.1236 189.5))",
        "--primary-foreground": "var(--ink)",
        "--secondary": "light-dark(oklch(52% 0 none), oklch(80.47% 0 none))",
        "--secondary-foreground": "var(--ink)",
        "--destructive": "light-dark(oklch(55% 0.1236 29), oklch(78.5% 0.1236 29))",
        "--destructive-foreground": "var(--ink)",
        "--warning": "light-dark(oklch(55% 0.1103 91.2), oklch(87.33% 0.1505 91.2))",
        "--warning-foreground": "var(--ink)",
        "--success": "light-dark(oklch(55% 0.1236 145), oklch(91.98% 0.1236 145))",
        "--success-foreground": "var(--ink)",
        "--muted": "light-dark(oklch(94.5% 0 none), oklch(22.5% 0.009 255.6))",
        "--muted-foreground": "color-mix(in oklch, var(--foreground) 70%, transparent)",
        "--accent": "var(--muted)",
        "--accent-foreground": "var(--foreground)",
        "--ink": "light-dark(oklch(100% 0 none), oklch(0% 0 none))",
        "--border": "color-mix(in oklch, var(--foreground) 62%, transparent)",
        "--border-strong": "color-mix(in oklch, var(--foreground) 40%, transparent)",
        "--border-soft": "color-mix(in oklch, var(--foreground) 30%, transparent)",
        "--input": "color-mix(in oklch, var(--foreground) 45%, transparent)",
        "--ring": "var(--primary)",
        "--chart-1": "light-dark(oklch(45% 0 none), oklch(52% 0 none))",
        "--chart-2": "var(--primary)",
        "--chart-3": "var(--warning)",
        "--chart-4": "var(--success)",
        "--chart-5": "var(--destructive)",
        "--sidebar": "var(--card)",
        "--sidebar-foreground": "var(--foreground)",
        "--sidebar-primary": "var(--primary)",
        "--sidebar-primary-foreground": "var(--ink)",
        "--sidebar-accent": "var(--muted)",
        "--sidebar-accent-foreground": "var(--foreground)",
        "--sidebar-border": "var(--border-soft)",
        "--sidebar-ring": "var(--primary)",
        "--radius": "0",
        "--type-mono": "'Overpass Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace",
        "--text-display": "clamp(2rem, 1.5rem + 2.5vw, 2.5rem)",
        "--duration-fast": "120ms",
        "--duration-base": "160ms",
        "--duration-slow": "200ms",
        "interpolate-size": "allow-keywords",
        "scrollbar-gutter": "stable",
        "text-wrap": "pretty",
        "overflow-wrap": "break-word",
        "font-synthesis": "none",
        "color-scheme": "dark",
        "overscroll-behavior-y": "none"
      },
      "[data-theme='dark'],\n.dark": {
        "color-scheme": "dark"
      },
      "[data-theme='light']": {
        "color-scheme": "light"
      },
      "[data-theme='system']": {
        "color-scheme": "light dark"
      },
      "h1,\nh2,\nh3,\nh4": {
        "text-wrap": "balance"
      },
      "input,\ntextarea,\nselect": {
        "font-size": "max(16px, 1rem)"
      },
      "body": {
        "margin": "0",
        "min-height": "100svh",
        "background": "var(--background)",
        "color": "var(--foreground)",
        "font-family": "var(--font-mono)",
        "font-size": "14px",
        "line-height": "1.5",
        "letter-spacing": "0",
        "-webkit-font-smoothing": "antialiased",
        "-moz-osx-font-smoothing": "grayscale"
      },
      ":where(button, a, [role='button'])": {
        "touch-action": "manipulation"
      },
