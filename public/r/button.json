        "min-height": "100svh",
        "background": "var(--color-base)",
        "color": "var(--color-fg)",
        "font-family": "var(--font-mono)",
        "font-size": "14px",
        "line-height": "1.5",
        "letter-spacing": "0",
        "-webkit-font-smoothing": "antialiased",
